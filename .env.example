# BetAgent environment template — NO REAL SECRETS.
# Copy to .env and fill only the integrations you plan to use.
# Never commit .env.

# Core runtime
BETAGENT_DB=betagent.db
BETAGENT_DB_PATH=betagent.db
BETAGENT_BANK=100000
BETAGENT_CACHE_DIR=.cache
STALE_PENDING_HOURS=48
ENABLE_CLV=0

# Admin panel (PANEL_PASS is mandatory before exposing the panel)
PANEL_USER=betagent
PANEL_PASS=

# LLM provider (OpenAI-compatible chat completions endpoint)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4-5

# Sports data providers
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
ALLSPORTS_API_KEY=
ODDS_API_KEY=
API_KEY=
FONBET_RESULTS_APIS=

# Telegram: admin bot, client bot and public channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CLIENT_BOT_TOKEN=
CHANNEL_BOT_TOKEN=
CHANNEL_ID=

# HTTP API and PostgreSQL-backed cabinet
API_BASE_URL=http://127.0.0.1:8001
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Subscription prices, RUB
PRICE_BASIC=990
PRICE_PRO=2490
PRICE_PREMIUM=4900

# YooKassa (optional)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# SMTP email verification (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
